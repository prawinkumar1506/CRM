# Supabase transaction-pooler connection string (port 6543), server only
DATABASE_URL=
# Optional CA PEM if your database certificate needs it; TLS stays verified
DATABASE_CA_CERT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://your-app.vercel.app
# Generate independent strong random values. Keep these server-side.
ADMIN_SETUP_TOKEN=
INTEGRATION_ENCRYPTION_KEY=
CRON_SECRET=
# Optional: HR may enter these in Settings instead, encrypted using the key above.
WA_TOKEN=
WA_PHONE_ID=
WA_TEMPLATE=
WA_DOCUMENT_TEMPLATE=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_LANGUAGE=en
WA_API_VERSION=v23.0

